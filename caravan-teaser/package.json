{
  "name": "caravan-fitness-teaser",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "studio": "npm run prepare-assets && remotion studio",
    "render:en": "remotion render TeaserEN out/caravan-fitness-teaser-en.mp4",
    "render:fa": "remotion render TeaserFA out/caravan-fitness-teaser-fa.mp4",
    "render:en-square": "remotion render TeaserENSquare out/caravan-fitness-teaser-en-1x1.mp4",
    "render:en-wide": "remotion render TeaserENWide out/caravan-fitness-teaser-en-16x9.mp4",
    "render:all": "npm run prepare-assets && npm run render:en && npm run render:fa && npm run render:en-square && npm run render:en-wide",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/vazirmatn": "5.3.0",
    "@remotion/cli": "4.0.544",
    "@remotion/fonts": "4.0.544",
    "@remotion/media-utils": "4.0.544",
    "pngjs": "7.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "@types/node": "22.20.5",
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  },
  "type": "module"
}
